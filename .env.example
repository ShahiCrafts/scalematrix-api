# Server Environment Variables Blueprint
PORT=5001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/scalematrix

# CORS Configuration
CLIENT_URL=http://localhost:5173

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_here_minimum_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_minimum_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth 2.0
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback/github

# Composio Integration Platform (https://composio.dev)
COMPOSIO_API_KEY=comp_your_composio_api_key_here
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3

# Resend Transactional Email Service (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
SENDER_EMAIL=onboarding@resend.dev
SENDER_NAME=ScaleMatrix

TOKEN_ENCRYPTION_KEY=scalematrix_secure_token_encryption_key_32_bytes_min!
